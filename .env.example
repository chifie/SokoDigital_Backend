[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
#  SokoDigital API — Environment Template
#
#  Copy this file to .env and adjust values for your local environment.
#   $ cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=SokoDigital API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development              # development | staging | production
APP_URL=http://localhost:5173

# ── API ───────────────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sokodigital_db

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS — Frontend origins (comma-separated list) ───────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# ── SMTP / Email (optional — transactional emails) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sokodigital.com

# ── AI / OpenAI-compatible (optional — AI shopping assistant) ────────────────
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024

# ── Redis (optional — distributed rate limiting & caching) ───────────────────
REDIS_URL=

# ── Cache (TTL for Redis response cache, in seconds) ─────────────────────────
CACHE_DEFAULT_TTL=60

# ── Sentry (optional — error tracking) ───────────────────────────────────────
SENTRY_DSN=
